{
  "name": "terrestre-spider",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Scraper do mercado imobiliario de Belo Horizonte, construido com Crawlee.",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@crawlee/impit-client": "^3.0.0",
    "@sentry/node": "^10.70.0",
    "crawlee": "^3.0.0",
    "pg": "^8.23.0",
    "playwright": "1.62.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@apify/tsconfig": "^0.2.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-sonarjs": "^3.0.0",
    "globals": "^15.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "tsx": "^4.4.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "start": "npm run start:dev",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "tsx --env-file-if-exists=.env src/main.ts",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/config/search-urls.json','dist/config/search-urls.json')\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "postinstall": "npx crawlee install-playwright-browsers",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "migration:generate": "node --env-file-if-exists=.env --import tsx node_modules/typeorm/cli.js migration:generate -d src/persistence/data-source.ts",
    "migration:run": "node --env-file-if-exists=.env --import tsx node_modules/typeorm/cli.js migration:run -d src/persistence/data-source.ts",
    "migration:revert": "node --env-file-if-exists=.env --import tsx node_modules/typeorm/cli.js migration:revert -d src/persistence/data-source.ts"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{ts,js,mjs,cjs,json,md}": [
      "prettier --write"
    ]
  },
  "author": "It's not you it's me",
  "license": "ISC"
}
