APIFY_LOG_LEVEL=INFO
# Produção deve setar isto para logs estruturados em JSON (pré-requisito para qualquer coleta
# futura via CloudWatch). Deixe sem setar em dev local para leitura humana no terminal.
# APIFY_LOG_FORMAT=JSON

# Sentry — opcional. Sem DSN, a captura de erro vira no-op automaticamente.
# SENTRY_DSN=

# Postgres — conexão com o Postgres compartilhado do projeto "terrestre" no Railway
# (dashboard > Postgres > Connect > Connection parameters, proxy TCP público).
# [YOUR-PASSWORD] é placeholder, pegue o valor real no painel.
POSTGRES_HOST=[YOUR-HOST].proxy.rlwy.net
POSTGRES_PORT=[YOUR-PORT]
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[YOUR-PASSWORD]
POSTGRES_DB=postgres

# Schema dedicado deste serviço no banco compartilhado (ver glossário do workspace).
# terrestre-spider é o dono do schema "terrestre" — dono das migrations e da estrutura das
# tabelas —, mas terra-em-foco-api também lê `anuncios`/`avistamentos` daqui diretamente
# (mesma credencial Postgres, connection própria em terra-em-foco-api/src/database).
# Obrigatório, sem default: nunca cai em "public" por omissão.
POSTGRES_SCHEMA=terrestre

# Exigência do provedor de Postgres gerenciado (não faz parte da conexão Postgres
# genérica acima) — obrigatório em produção, desligado em dev.
POSTGRES_SSL=true

# S3 (compatível com AWS S3 e MinIO) — onde o HTML/JSON bruto de cada página raspada
# é gravado, pra permitir reprocessar sem raspar de novo e diagnosticar páginas
# bloqueadas. Sem S3_ENDPOINT, o SDK usa o endpoint real da AWS — setar só em dev local,
# apontando pro MinIO de ../terrestre-minio (projeto separado deste; subir com
# `docker compose up -d` de lá). Hostname "minio", não "127.0.0.1": o spider roda
# containerizado (ver docker-compose.yml) e é anexado à rede `terrestre-local`
# justamente para resolver o MinIO pelo nome do serviço nessa rede — 127.0.0.1 dentro
# do container aponta para o próprio container, nunca para a porta publicada no host.
S3_ENDPOINT=http://minio:9000
AWS_REGION=us-east-1
# Precisa bater com MINIO_ROOT_USER/MINIO_ROOT_PASSWORD em
# ../terrestre-minio/docker-compose.yml — MinIO valida credencial de verdade (senha
# mín. 8 caracteres), diferente do antigo LocalStack. Em produção, usar credenciais
# reais de IAM restritas ao bucket.
AWS_ACCESS_KEY_ID=terrestre
AWS_SECRET_ACCESS_KEY=terrestre-local-dev
# Tem default no código (terrestre-capturas-brutas) — só setar se for usar outro nome.
# S3_BUCKET_CAPTURAS_BRUTAS=terrestre-capturas-brutas

# Teto de páginas de LISTAGEM/BUSCA por URL de busca (default 20, ver crawler-defaults.ts) —
# não cobre a fase de detalhe (visita cada anúncio único descoberto, sem teto próprio). Não
# deixar setado permanentemente — só para runs pontuais de seed inicial, passado na hora de
# rodar (ex.: SPIDER_MAX_LISTING_PAGES_PER_CRAWL=1000 npm run start:prod), nunca fixo aqui no .env.
# SPIDER_MAX_LISTING_PAGES_PER_CRAWL=1000

# Quantas fontes o orquestrador (src/main.ts) roda ao mesmo tempo (default 1,
# sequencial — ver crawler-defaults.ts). Mesma lógica do teto de páginas acima: elevar
# é decisão pontual por execução, nunca fixo aqui — a EC2 de produção roda Postgres +
# API + crawler juntos, RAM limitada pra vários browsers headless simultâneos.
# SPIDER_BATCH_SIZE=2

# DeepSeek — usado só por src/scripts/analisar-qualidade-capturas.ts (classifica uma amostra
# de capturas_brutas como válida/bloqueada/captcha/vazia via LLM). Pegue a chave em
# platform.deepseek.com > API keys. Sem relação com a pipeline de captura em si.
DEEPSEEK_API_KEY=[YOUR-API-KEY]
# Tem default no código (deepseek-chat) — só setar para trocar de modelo (ex.: deepseek-reasoner).
# DEEPSEEK_MODEL=deepseek-chat

# Senha de Basic Auth que o serviço "trigger" (docker-compose.yml) exige em POST /run antes
# de disparar uma run do spider. O MESMO valor precisa estar em terrestre-grafana/.env
# (TRIGGER_WEBHOOK_PASSWORD) — são dois .env de projetos docker-compose separados, sem
# sincronização automática entre eles.
TRIGGER_WEBHOOK_PASSWORD=[YOUR-PASSWORD]
# Porta publicada no host pelo trigger. Precisa bater com TRIGGER_PORT em
# terrestre-grafana/.env (é lá que o contact point monta a URL de destino). Default 8088.
# TRIGGER_PORT=8088

