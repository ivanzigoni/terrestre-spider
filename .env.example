APIFY_LOG_LEVEL=INFO
# Produção deve setar isto para logs estruturados em JSON (pré-requisito para qualquer coleta
# futura via CloudWatch). Deixe sem setar em dev local para leitura humana no terminal.
# APIFY_LOG_FORMAT=JSON

# Sentry — opcional. Sem DSN, a captura de erro vira no-op automaticamente.
# SENTRY_DSN=

# Postgres — conexão direta com o Supabase (painel > Connect > Connection parameters).
# [YOUR-PASSWORD] é placeholder, pegue o valor real no painel.
POSTGRES_HOST=db.izvijcursburkuiwhrsv.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[YOUR-PASSWORD]
POSTGRES_DB=postgres

# Exigência específica do Supabase (não faz parte da conexão Postgres genérica acima) —
# obrigatório em produção, desligado em dev.
SUPABASE_SSL=true

# Teto de páginas por URL de busca (default 20, ver crawler-defaults.ts). Não deixar setado
# permanentemente — só para runs pontuais de seed inicial, passado na hora de rodar
# (ex.: SPIDER_MAX_REQUESTS_PER_CRAWL=1000 npm run start:prod), nunca fixo aqui no .env.
# SPIDER_MAX_REQUESTS_PER_CRAWL=1000

# Senha de Basic Auth que o serviço "trigger" (docker-compose.yml) exige em POST /run antes
# de disparar uma run do spider. O MESMO valor precisa estar em terrestre-grafana/.env
# (TRIGGER_WEBHOOK_PASSWORD) — são dois .env de projetos docker-compose separados, sem
# sincronização automática entre eles.
TRIGGER_WEBHOOK_PASSWORD=[YOUR-PASSWORD]
# Porta publicada no host pelo trigger. Precisa bater com TRIGGER_PORT em
# terrestre-grafana/.env (é lá que o contact point monta a URL de destino). Default 8088.
# TRIGGER_PORT=8088

