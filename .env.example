LOG_LEVEL=info

# Postgres — conexão direta com o Supabase (painel > Connect > Connection parameters).
# [YOUR-PASSWORD] é placeholder, pegue o valor real no painel.
POSTGRES_HOST=db.izvijcursburkuiwhrsv.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[YOUR-PASSWORD]
POSTGRES_DB=postgres

# Dev local (`docker compose up -d`) usa outro Postgres, não o Supabase acima:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=terrestre
# POSTGRES_PASSWORD=terrestre
# POSTGRES_DB=terrestre_spider

# Exigência específica do Supabase (não faz parte da conexão Postgres genérica acima) —
# obrigatório em produção, desligado em dev.
SUPABASE_SSL=true

